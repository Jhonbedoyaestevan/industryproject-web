{#- Botones de redes. Enlaces simples: no cargan scripts ni píxeles de terceros. -#}
<ul class="social{% if socialClass %} {{ socialClass }}{% endif %}" aria-label="Redes y contacto directo">
  {% if site.redes.linkedin %}
  <li><a href="{{ site.redes.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.whatsapp %}
  <li><a href="https://wa.me/{{ site.redes.whatsapp | digits }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3Z"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.email %}
  <li><a href="mailto:{{ site.redes.email }}" aria-label="Correo electrónico">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 5h18v14H3z"/><path fill="none" stroke="currentColor" stroke-width="2" d="m3 6 9 7 9-7"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.x %}
  <li><a href="{{ site.redes.x }}" target="_blank" rel="noopener noreferrer" aria-label="X (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.2 2H21l-6.6 7.6L22 22h-6l-4.7-6.2L5.8 22H3l7-8.1L2 2h6.1l4.3 5.7L18.2 2Zm-1 18h1.6L7 3.9H5.3L17.2 20Z"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.instagram %}
  <li><a href="{{ site.redes.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.youtube %}
  <li><a href="{{ site.redes.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.8 15V9l5.7 3-5.7 3Z"/></svg>
  </a></li>
  {% endif %}
  {% if site.redes.facebook %}
  <li><a href="{{ site.redes.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook (abre en nueva pestaña)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M14 8V6.3c0-.8.2-1.3 1.4-1.3H17V2h-2.6C11.3 2 10 3.7 10 6.5V8H8v3h2v11h4V11h2.7l.3-3H14Z"/></svg>
  </a></li>
  {% endif %}
</ul>
