{#- Tarjeta de curso. Requiere variable `item`. -#}
{%- set cursoUrl = item.data.enlace or item.url -%}
<article class="card curso-card">
  <a class="card-media" href="{{ cursoUrl }}" tabindex="-1" aria-hidden="true">
    {% if item.data.imagen %}
      <img src="{{ item.data.imagen }}" alt="" loading="lazy" decoding="async" width="640" height="400">
    {% else %}
      <span class="card-media-placeholder"></span>
    {% endif %}
  </a>
  <div class="card-body">
    {% if item.data.categoria %}<span class="chip">{{ item.data.categoria }}</span>{% endif %}
    <h3 class="card-title"><a href="{{ cursoUrl }}">{{ item.data.title }}</a></h3>
    {% if item.data.resumen %}<p class="card-excerpt">{{ item.data.resumen }}</p>{% endif %}
    {% if item.data.puntos.length %}
    <ul class="curso-puntos">
      {% for p in item.data.puntos | limit(4) %}<li>{{ p }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if item.data.duracion or item.data.modalidad %}
    <p class="card-meta">{% if item.data.duracion %}<strong>{{ item.data.duracion }}</strong>{% endif %}{% if item.data.duracion and item.data.modalidad %} · {% endif %}{{ item.data.modalidad }}</p>
    {% endif %}
    <div class="curso-actions">
      <a class="btn btn-primary btn-sm" href="/?curso={{ item.data.title | urlencode }}#contacto">Matricularme<span class="sr-only"> en {{ item.data.title }}</span></a>
      <a class="card-more" href="{{ cursoUrl }}">Ver curso <span class="sr-only">{{ item.data.title }}</span>→</a>
    </div>
  </div>
</article>
