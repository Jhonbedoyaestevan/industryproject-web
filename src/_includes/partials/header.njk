<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="{{ site.marca }} — inicio">
      <span class="brand-mark" aria-hidden="true">
        <img src="{{ site.logo | default('/assets/img/IMAGEN PW.png') }}" alt="{{ site.marca }}" class="brand-logo-img">
      </span>
      <span class="brand-text">
        <strong>{{ site.marca }}</strong>
        <small>{{ site.lema }}</small>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="sr-only">Abrir menú</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" class="main-nav" aria-label="Principal">
      <ul>
        <li><a href="/#servicios">Servicios</a></li>
        <li><a href="/proyectos/"{% if "/proyectos/" in page.url %} aria-current="page"{% endif %}>Proyectos</a></li>
        <li><a href="/noticias/"{% if "/noticias/" in page.url %} aria-current="page"{% endif %}>Noticias</a></li>
        <li><a href="/#perfil">Perfil</a></li>
        <li><a class="btn btn-primary btn-sm" href="/#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>
