---
layout: layouts/base.njk
title: Cursos de altura, confinados, rescate, verticales e ITRA
description: Cursos de trabajos en altura, trabajos verticales, rescate, espacios confinados y certificaciones internacionales ITRA/IRATA. En centro de formación o en sus instalaciones, en toda España.
permalink: /formacion/
---
{% set fp = formacion_pagina %}
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan"><a href="/">Inicio</a> <span aria-hidden="true">/</span> Formación</nav>
    {% if fp.antetitulo %}<p class="eyebrow">{{ fp.antetitulo }}</p>{% endif %}
    <h1>{{ fp.titulo or "Formación" }}</h1>
    {% if fp.intro %}<p class="landing-lead">{{ fp.intro }}</p>{% endif %}
    {% if fp.imagen %}<img class="formacion-hero-img" src="{{ fp.imagen }}" alt="{{ fp.imagen_alt or '' }}" width="1600" height="700" fetchpriority="high">{% endif %}
    <div class="hero-actions">
      <a class="btn btn-primary" href="/#contacto">Solicitar información</a>
      <a class="btn btn-outline" href="#cursos">Ver cursos</a>
    </div>
  </div>
</section>
<section class="section" id="cursos">
  <div class="container">
    {% if collections.formacion.length %}
    <div class="cards-grid">
      {% for item in collections.formacion %}{% include "partials/curso-card.njk" %}{% endfor %}
    </div>
    {% else %}
    <p>Próximamente publicaremos aquí los cursos disponibles.</p>
    {% endif %}
  </div>
</section>
